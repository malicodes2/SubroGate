# ==============================================================================
# SubroGate Environment Configuration (Template)
# Copy this file to .env and configure for your local or cloud environment.
# ==============================================================================

# Application Settings
SUBROGATE_ENV=production
SUBROGATE_HOST=0.0.0.0
SUBROGATE_PORT=8080
SUBROGATE_LOG_LEVEL=INFO

# Centralized Model Strategy
# Configure with eligible Gemini 3.5+ model (e.g. gemini-3.5-flash, gemini-3.5-pro)
SUBROGATE_GEMINI_MODEL=gemini-3.5-flash

# Google GenAI / Vertex AI Configuration
# Option 1: AI Studio API Key (Local Development)
GEMINI_API_KEY=

# Option 2: Google Cloud Vertex AI (Cloud Run / Enterprise Production)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
SUBROGATE_USE_VERTEX=true

# Security & CORS (Comma-separated allowed origins)
CORS_ORIGINS=https://malicodes2.github.io,https://muhammadasghar0.github.io,http://localhost:5173,http://localhost:8000
