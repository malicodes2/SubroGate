# ==============================================================================
# SubroGate Production .gitignore
# ==============================================================================

# Environment & Local Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
service_account*.json
credentials.json

# Private Demo & Development Artifacts
private-demo/
demo_data/
demo-recordings/
recordings/
screenshots/
scratch/
.system_generated/

# Python & Testing
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log

# Python Environments
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node / Frontend Build
frontend/node_modules/
frontend/dist/
frontend/.npm/
frontend/.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# IDE / Customizations
.gemini/
.agents/
